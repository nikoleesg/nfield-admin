{
    "name": "nikoleesg/nfield-admin",
    "description": "A Laravel SDK for the NField v2 Admin API: surveys, fieldwork, sample, sampling points, quota and CAPI interviewers behind a fluent, typed interface.",
    "keywords": [
        "nikoleesg",
        "laravel",
        "nfield",
        "nfield-admin",
        "nipo",
        "survey",
        "market-research",
        "sdk"
    ],
    "homepage": "https://github.com/nikoleesg/nfield-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Niko Lee",
            "email": "Niko.lee@outlook.sg",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.20",
        "pestphp/pest-plugin-arch": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Nikoleesg\\NfieldAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nikoleesg\\NfieldAdmin\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-nfield-admin --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nikoleesg\\NfieldAdmin\\NfieldAdminServiceProvider"
            ],
            "aliases": {
                "NfieldManager": "Nikoleesg\\NfieldAdmin\\Facades\\NfieldManager"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
