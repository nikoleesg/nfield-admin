# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Keep development-only paths out of the dist archive Packagist builds.
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.github                export-ignore
/.gitignore             export-ignore
/phpstan-baseline.neon  export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/pint.json              export-ignore
/tests                  export-ignore
/workbench              export-ignore

# Local agent and working files. `.gitignore` already keeps these out of the
# repository; the entries are here so they cannot reach a dist archive even if
# one of them is ever committed deliberately.
/.agents                export-ignore
/.claude                export-ignore
/.mcp.json              export-ignore
/AGENTS.md              export-ignore
/CLAUDE.md              export-ignore
/docs                   export-ignore
/memory                 export-ignore
/testbench.yaml         export-ignore
